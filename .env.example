# Optional: enables MapTiler terrain elevation and richer 3D map styling.
NEXT_PUBLIC_MAPTILER_KEY=

# --- Admin Edit Mode (server-side only; never prefix with NEXT_PUBLIC_) ---
# Passcode that unlocks /admin. Choose your own.
ADMIN_PASSCODE=
# Random string (32+ chars) used to sign session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=

# --- GitHub synchronization (Phase 2; server-side only, never prefix with NEXT_PUBLIC_) ---
# Fine-grained personal access token for ONLY this repository:
#   Contents: Read and write (required) | Metadata: Read (automatic)
#   Optional, for the deployment status display: Deployments: Read, Commit statuses: Read, Checks: Read
# Create it at https://github.com/settings/personal-access-tokens . Never commit it.
GITHUB_TOKEN=
# Repository to push to, as owner/repo (or leave empty to use this folder's existing "origin" remote).
GITHUB_REPOSITORY=
# Branch to publish to (default: main).
GITHUB_BRANCH=main
# Identity shown on the automatic commits (optional).
GIT_AUTHOR_NAME=Portfolio Admin
GIT_AUTHOR_EMAIL=portfolio-admin@users.noreply.github.com
